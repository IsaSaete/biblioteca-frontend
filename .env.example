# Opcional. Si se deja vacía, la API se llama en /api (mismo origen): proxy de
# Netlify en producción y proxy de Vite en desarrollo. Solo se rellena para
# llamar a un backend directamente (otro origen), sin barra final.
VITE_API_URL=

# Opcional, solo desarrollo. Backend al que apunta el proxy de Vite en /api.
# Por defecto http://localhost:4000.
API_PROXY_TARGET=
