/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://books.google.com https://covers.openlibrary.org https://archive.org https://*.archive.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
/manifest.webmanifest
  Content-Type: application/manifest+json

# Caché (D-056). Los archivos de /assets/ los genera Vite con un código en el
# nombre (index-DC9EfqcE.js) que cambia con cada versión: pueden guardarse un
# año sin preguntar al servidor. index.html NO lleva regla: debe seguir
# revalidándose para que cada despliegue llegue a todo el mundo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Archivos con nombre fijo (sin código en el nombre): un mes, no para siempre,
# por si alguno cambia. Si cambia, se renombra.
/fonts/*
  Cache-Control: public, max-age=2592000
/tesseract/*
  Cache-Control: public, max-age=2592000

# Las tres fuentes que pintan la portada de la landing se piden desde el
# principio, en paralelo con el JavaScript. Antes se precargaban desde React,
# cuando la página ya se estaba pintando, y se descargaban dos veces (una por la
# precarga y otra por el CSS). Solo en `/`: el resto de pantallas no las usan.
/
  Link: </fonts/besley-normal-500-latin.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin, </fonts/alegreya-normal-400-700-latin.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin, </fonts/alegreya-sans-normal-500-latin.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin

